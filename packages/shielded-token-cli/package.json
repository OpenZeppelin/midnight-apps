{
	"name": "@openzeppelin/midnight-apps-shielded-token-cli",
	"version": "1.0.0-alpha.1",
	"private": true,
	"type": "module",
	"scripts": {
		"local": "node --no-deprecation --experimental-specifier-resolution=node --import ./src/register-loader.mjs src/launcher/local.ts",
		"preprod": "node --no-deprecation --experimental-specifier-resolution=node --import ./src/register-loader.mjs src/launcher/preprod.ts",
		"verify-addresses": "node --no-deprecation --experimental-specifier-resolution=node --import ./src/register-loader.mjs src/scripts/verify-addresses.ts",
		"build": "rm -rf dist && tsc --project tsconfig.build.json",
		"fmt": "biome format --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"types": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"axios": "^1.12.0",
		"@midnight-ntwrk/compact-runtime": "0.15.0",
		"@midnight-ntwrk/testkit-js": "4.0.0-rc.1",
		"@midnight-ntwrk/ledger-v8": "8.0.2",
		"@midnight-ntwrk/midnight-js-contracts": "4.0.2",
		"@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.2",
		"@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.2",
		"@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.2",
		"@midnight-ntwrk/midnight-js-network-id": "4.0.2",
		"@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.2",
		"@midnight-ntwrk/midnight-js-types": "4.0.2",
		"@midnight-ntwrk/midnight-js-utils": "4.0.2",
		"@midnight-ntwrk/wallet-sdk-address-format": "3.1.0-rc.0",
		"@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0-rc.0",
		"@midnight-ntwrk/wallet-sdk-facade": "3.0.0-rc.0",
		"@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
		"@midnight-ntwrk/wallet-sdk-shielded": "2.1.0-rc.0",
		"@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0-rc.0",
		"@openzeppelin/midnight-apps-contracts": "workspace:*",
		"@openzeppelin/midnight-apps-shielded-token-api": "workspace:*",
		"@openzeppelin/midnight-networks": "workspace:*",
		"@scure/bip39": "^1.2.1",
		"pino": "^9.7.0",
		"pino-pretty": "^13.0.0",
		"rxjs": "^7.8.1",
		"testcontainers": "^10.28.0",
		"ws": "^8.16.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.7",
		"@types/ws": "^8.5.10",
		"eslint": "^9.30.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
